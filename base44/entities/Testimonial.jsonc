{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "autor": {
      "type": "string"
    },
    "pet_nome": {
      "type": "string"
    },
    "texto": {
      "type": "string"
    },
    "nota": {
      "type": "number",
      "default": 5
    },
    "publicado": {
      "type": "boolean",
      "default": true
    }
  },
